@using Swidge.Models
@{
    ViewData["Title"] = "Historial de Transacciones";
    List<HistorialTransaccion> historial = ViewBag.Historial as List<HistorialTransaccion>;
}

<div class="container my-4 entradas-page">
    <div class="entradas-header entradas-header-compradas">
        <small>TU ESPACIO SWIDGE</small>
        <h1>HISTORIAL DE TRANSACCIONES</h1>
    </div>
    @if (historial == null || !historial.Any())
    {
        <div class="alert alert-secondary text-center py-4" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else
    {
        <div class="entradas-list">
            @foreach (HistorialTransaccion transaccion in historial)
            {
                bool esCompra = transaccion.Tipo == "Compra";
                string imagenEvento = string.IsNullOrWhiteSpace(transaccion.Imagen)
                    ? Url.Content("~/img/null.jpg")
                    : Url.Content("~/img/" + transaccion.Imagen);

                <div class="entrada-card @(esCompra ? "entrada-card-comprada" : "entrada-card-publicada")">
                    <div class="row g-0 align-items-center">
                        <div class="col-12 col-md-3">
                            <img src="@imagenEvento"
                                 class="entrada-image"
                                 alt="@(transaccion.NombreEvento)">
                        </div>
                        <div class="col-12 col-md-9 entrada-body">
                            <span class="entrada-date">
                                @transaccion.Tipo.ToUpper() - @transaccion.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </span>
                            <h4 class="entrada-title">@transaccion.NombreEvento</h4>
                            @if (!string.IsNullOrEmpty(transaccion.Protagonista))
                            {
                                <small class="entrada-protagonista">@transaccion.Protagonista</small>
                            }
                            <p class="entrada-location">
                                <i class="bi bi-geo-alt-fill me-1"></i>@transaccion.Lugar
                                - @transaccion.FechaEvento.ToString("dddd dd/MM").ToUpper()
                            </p>
                            <p class="entrada-location">
                                @(esCompra ? "Comprada a" : "Vendida a"): @transaccion.Contraparte
                                - Entrada #@transaccion.IDEntrada
                            </p>

                            <div class="entrada-actions">
                                <span class="badge entrada-badge entrada-badge-primary">
                                    @transaccion.Estado
                                </span>
                                <span class="entrada-price">
                                    @if (esCompra)
                                    {
                                        <text>Total pagado: $@transaccion.MontoTotal.ToString("N2")</text>
                                    }
                                    else
                                    {
                                        <text>Total recibido: $@((transaccion.MontoTotal - transaccion.Comision).ToString("N2"))</text>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
