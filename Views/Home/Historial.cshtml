@using Swidge.Models
@{
    ViewData["Title"] = "Historial de Transacciones";
    List<HistorialTransaccion> historial = ViewBag.Historial as List<HistorialTransaccion>;
}

<div class="container my-4 entradas-page">
    <div class="entradas-header entradas-header-compradas">
        <small>TU ESPACIO SWIDGE</small>
        <h1>HISTORIAL DE TRANSACCIONES</h1>
    </div>
    @if (historial == null || !historial.Any())
    {
        <div class="alert alert-secondary text-center py-4" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else
    {
        <div class="entradas-list">
            @foreach (var transaccion in historial)
            {
                bool esCompra = transaccion.Tipo == "Compra";
                bool esPublicacion = transaccion.Tipo == "Publicacion";
                bool fueVendida = esPublicacion && transaccion.Vendida;
                var imagenEvento = string.IsNullOrWhiteSpace(transaccion.Imagen)
                    ? Url.Content("~/img/null.jpg")
                    : Url.Content("~/img/" + transaccion.Imagen);

                <div class="entrada-card @(esPublicacion ? "entrada-card-publicada" : (esCompra ? "entrada-card-comprada" : "entrada-card-publicada"))">
                    <div class="row g-0 align-items-center">
                        <div class="col-12 col-md-3">
                            <img src="@imagenEvento"
                                 class="entrada-image"
                                 alt="@(transaccion.NombreEvento)">
                        </div>
                        <div class="col-12 col-md-9 entrada-body">
                            <span class="entrada-date">
                                @if (esPublicacion)
                                {
                                    <text>PUBLICACIÓN - @(fueVendida ? "VENDIDA" : "DISPONIBLE")</text>
                                }
                                else
                                {
                                    <text>@transaccion.Tipo.ToUpper() - @transaccion.Fecha.ToString("dd/MM/yyyy HH:mm")</text>
                                }
                            </span>
                            <h4 class="entrada-title">@transaccion.NombreEvento</h4>
                            @if (!string.IsNullOrEmpty(transaccion.Protagonista))
                            {
                                <small class="entrada-protagonista">@transaccion.Protagonista</small>
                            }
                            <p class="entrada-location">
                                <i class="bi bi-geo-alt-fill me-1"></i>@transaccion.Lugar
                                - @transaccion.FechaEvento.ToString("dddd dd/MM").ToUpper()
                            </p>
                            <p class="entrada-location">
                                @if (esCompra)
                                {
                                    <text>Comprada a: @transaccion.Contraparte - Entrada #@transaccion.IDEntrada</text>
                                }
                                else if (esPublicacion)
                                {
                                    @if (fueVendida)
                                    {
                                        <text>Vendida a: @transaccion.Contraparte - Entrada #@transaccion.IDEntrada</text>
                                    }
                                    else
                                    {
                                        <text>Todavía no se vendió - Entrada #@transaccion.IDEntrada</text>
                                    }
                                }
                                else
                                {
                                    <text>Vendida a: @transaccion.Contraparte - Entrada #@transaccion.IDEntrada</text>
                                }
                            </p>

                            <div class="entrada-actions">
                                <span class="badge entrada-badge @(esPublicacion ? (fueVendida ? "entrada-badge-success" : "entrada-badge-warning") : "entrada-badge-primary")">
                                    @transaccion.Estado
                                </span>
                                <span class="entrada-price @(esPublicacion ? (fueVendida ? "entrada-price-sold" : "entrada-price-pending") : "")">
                                    @if (esCompra)
                                    {
                                        <text>Total pagado: $@transaccion.MontoTotal.ToString("N2")</text>
                                    }
                                    else if (esPublicacion)
                                    {
                                        @if (fueVendida)
                                        {
                                            <text>Precio vendido: $@transaccion.MontoTotal.ToString("N2")</text>
                                        }
                                        else
                                        {
                                            <text>Precio publicado: $@transaccion.MontoTotal.ToString("N2")</text>
                                        }
                                    }
                                    else
                                    {
                                        <text>Total recibido: $@((transaccion.MontoTotal - transaccion.Comision).ToString("N2"))</text>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
