@model Swidge.Models.Entrada

@{
    ViewData["Title"] = "Detalle de entrada";
    var evento = Model?.Evento ?? new Swidge.Models.Evento();
    var vendedor = Model?.Vendedor ?? new Swidge.Models.Usuario();

    var nombreVendedor = !string.IsNullOrWhiteSpace(vendedor.Nombre) || !string.IsNullOrWhiteSpace(vendedor.Apellido)
        ? $"{vendedor.Nombre} {vendedor.Apellido}".Trim()
        : "VENDEDOR";

    var fecha = evento.Fecha != default ? evento.Fecha.ToString("ddd, dd MMM, HH:mm") : "Fecha por confirmar";
    var precio = Model?.Precio > 0 ? Model.Precio.ToString("N0") : "0";

    var imagen = !string.IsNullOrWhiteSpace(evento.Imagen)
        ? evento.Imagen
        : (!string.IsNullOrWhiteSpace(Model?.Imagen) ? Model.Imagen : "/img/null.jpg");

    var categoria = string.IsNullOrWhiteSpace(evento.Categoria) ? "General" : evento.Categoria;
    var protagonista = string.IsNullOrWhiteSpace(evento.Protagonista) ? "Artista por confirmar" : evento.Protagonista;
    var descripcion = string.IsNullOrWhiteSpace(evento.Descripcion) ? "Descripción no disponible." : evento.Descripcion;
    var cantidadEntradas = evento.CantidadEntradas > 0 ? evento.CantidadEntradas : 0;
}

<div class="detalle-page">
    <section class="detalle-evento">
        <div class="detalle-media" style="background-image: url('@imagen'); background-size: cover; background-position: center;" aria-label="Cartel del evento"></div>

        <div class="detalle-header">
            <h1 class="detalle-titulo">@evento.Nombre</h1>

            <div class="detalle-meta">
                <div class="detalle-meta-item">
                    <span class="detalle-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                            <path d="M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2zm13 8H4v10h16V10zm-2-4H5v2h14V6z"/>
                        </svg>
                    </span>
                    <span>@fecha</span>
                </div>

                <div class="detalle-meta-item">
                    <span class="detalle-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8zm0 10.5A2.5 2.5 0 1 1 12 7a2.5 2.5 0 0 1 0 5.5z"/>
                        </svg>
                    </span>
                    <span>@(string.IsNullOrWhiteSpace(evento.Lugar) ? "Lugar por confirmar" : evento.Lugar)</span>
                </div>
            </div>
        </div>

        <div class="detalle-evento-info">
            <div class="info-row">
                <span class="label">Protagonista:</span>
                <span class="value">@protagonista</span>
            </div>
            <div class="info-row">
                <span class="label">Categoría:</span>
                <span class="value">@categoria</span>
            </div>
            <div class="info-row">
                <span class="label">Entradas disponibles:</span>
                <span class="value">@cantidadEntradas</span>
            </div>
            <div class="info-row descripcion-row">
                <span class="label">Descripción:</span>
                <p class="value descripcion">@descripcion</p>
            </div>
        </div>
    </section>

    <aside class="detalle-compra">
        <div class="precio-panel">
            <p class="precio-etiqueta">PRECIO DE LA ENTRADA</p>
            <div class="precio-valor">@precio<span>$</span></div>
            <div class="precio-ahorro">Ahorras 2.000$ frente al precio original</div>
            <button class="boton-comprar" type="button">comprar</button>
        </div>

        <div class="vendedor-panel">
            <p class="vendedor-titulo">INFORMACIÓN DEL VENDEDOR</p>

            <div class="vendedor-fila">
                <div class="vendedor-avatar" aria-label="Avatar del vendedor">@(!string.IsNullOrWhiteSpace(vendedor.Nombre) ? vendedor.Nombre.Substring(0, 1).ToUpperInvariant() : "V")</div>
                <div class="vendedor-nombre">@nombreVendedor.ToUpperInvariant()</div>
                <div class="vendedor-estrellas" aria-label="Calificación 5 de 5">★★★★★</div>
            </div>
        </div>
    </aside>
</div>
