@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="forgot-password-page">
    <section class="forgot-password-card" aria-labelledby="forgot-password-title">
        <div class="forgot-password-header">
            <h1 id="forgot-password-title">Enviamos un código a<br />tu correo electrónico</h1>
        </div>

        <div class="forgot-password-body">
            <form class="forgot-password-form" method="get" action="" onsubmit="return false;">
                <label for="codigoRecuperacion">Ingrese el código:</label>
                <input type="text" id="codigoRecuperacion" name="codigo" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="Código" />

                <button type="submit" class="forgot-password-submit">Enviar</button>
            </form>

            <nav class="forgot-password-actions" aria-label="Opciones de recuperación">
                <a class="forgot-password-link forgot-password-link--secondary" href="@Url.Action("OlvideMiContraseña", "Home")" onclick="window.location.reload(); return false;">Volver a enviar el código</a>
                <a class="forgot-password-link" asp-controller="Home" asp-action="Ayuda">¿Necesitás ayuda?</a>
            </nav>
        </div>
    </section>
</div>
