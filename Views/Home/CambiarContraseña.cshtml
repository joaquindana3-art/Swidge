@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="password-change-page">
    <section class="password-change-card" aria-labelledby="password-change-title">
        <div class="password-change-header">
            <h1 id="password-change-title">Cambiar<br />contraseña</h1>
        </div>

        <div class="password-change-body">
            @if (ViewBag.Errores != null)
            {
                <div class="password-change-alert" role="alert">
                    @foreach (string error in ViewBag.Errores)
                    {
                        <div>@error</div>
                    }
                </div>
            }

            <form class="password-change-form" method="post" action="@Url.Action("CambiarContraseña", "Session")" novalidate>
                @Html.AntiForgeryToken()

                <input type="password" id="contrasenaActual" name="contrasenaActual" autocomplete="current-password" maxlength="72" placeholder="Contraseña actual" required />
                <input type="password" id="contrasenaNueva" name="contrasenaNueva" autocomplete="new-password" maxlength="72" placeholder="Nueva contraseña" minlength="8" required />
                <input type="password" id="confirmarContrasena" name="confirmarContrasena" autocomplete="new-password" maxlength="72" placeholder="Confirmar nueva contraseña" minlength="8" required />

                <button type="submit" class="password-change-submit">Cambiar</button>

                <img class="password-change-brand" src="~/img/logoswidgeNegroTransparente.png" alt="Swidge" />
            </form>
        </div>
    </section>
</div>
