@using Swidge.Models
@{
    ViewData["Title"] = "Mis Entradas Publicadas";
    List<Entrada> listaPublicadas = ViewBag.EntradasPublicadas as List<Entrada>;
}

<div class="container my-4 entradas-page">
    <div class="entradas-header entradas-header-publicadas">
        <small>TU ESPACIO SWIDGE</small>
        <h1>MIS ENTRADAS PUBLICADAS</h1>
    </div>
    @if (listaPublicadas == null || !listaPublicadas.Any())
    {
        <div class="alert alert-secondary text-center py-4" role="alert">
            @ViewBag.mensaje
        </div>
    }
    else
    {
        <div class="entradas-list">
            @foreach (var entrada in listaPublicadas)
            {
                var evento = entrada.Evento ?? new Swidge.Models.Evento { Nombre = "Evento", Lugar = "Lugar", Fecha = DateTime.Now };
                var imagenEvento = string.IsNullOrWhiteSpace(evento.Imagen)
                    ? Url.Content("~/img/null.jpg")
                    : Url.Content("~/img/" + evento.Imagen);

                <div class="entrada-card entrada-card-publicada">
                    <div class="row g-0 align-items-center">
                        <div class="col-12 col-md-3">
                            <img src="@imagenEvento"
                                 class="entrada-image"
                                 alt="@(evento.Nombre)">
                        </div>
                        <!-- Información de la Publicación y Acciones -->
                        <div class="col-12 col-md-9 entrada-body">
                            @if (entrada.Evento != null)
                            {
                                <span class="entrada-date">
                                    @entrada.Evento.Fecha.ToString("dddd dd/MM").ToUpper()
                                </span>
                                <h4 class="entrada-title">@entrada.Evento.Nombre</h4>
                                @if (!string.IsNullOrEmpty(entrada.Evento.Protagonista))
                                {
                                    <small class="entrada-protagonista">@entrada.Evento.Protagonista</small>
                                }
                                <p class="entrada-location">
                                    <i class="bi bi-geo-alt-fill me-1"></i>@entrada.Evento.Lugar
                                </p>
                            }
                            else
                            {
                                <h4 class="entrada-title">Entrada #@entrada.ID</h4>
                            }

                            <div class="entrada-actions">
                                <div>
                                    <a href="@Url.Action("EditarEntrada", "Home", new { id = entrada.ID })" class="btn btn-primary btn-sm px-4 fw-bold entrada-btn entrada-btn-editar">
                                        Editar
                                    </a>
                                    @if (entrada.Vendida)
                                    {
                                        <span class="badge entrada-badge entrada-badge-success">Vendida</span>
                                    }
                                    else
                                    {
                                        <span class="badge entrada-badge entrada-badge-warning">En Venta</span>
                                    }
                                </div>
                                <span class="entrada-price">
                                    $@entrada.Precio
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>