<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title> Mi perfil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
  </head>
  <body>
    <main>
      <h3>Mi perfil</h3>
      <div class="container text-center">
        <div class="row">
          <div class="col-8">
            <div class="card">
              <div class="card-body">
                @if (ViewBag.Usuario != null)
                {
                    <h3>Información de mi perfil</h3>
                    <p>Nombre: @ViewBag.Usuario.Nombre</p>
                    <p>Apellido: @ViewBag.Usuario.Apellido</p>
                    <p>Nombre de usuario: @ViewBag.Usuario.NombreUsuario</p>
                    <p>Fecha de nacimiento: @ViewBag.Usuario.FechaNacimiento.ToString("dd/MM/yyyy")</p>
                    <p>Correo electrónico: @ViewBag.Usuario.Mail</p>
                    <p>DNI: @ViewBag.Usuario.DNI</p>
                    <p>Ciudad: @ViewBag.Usuario.Ciudad</p>
                }
                else
                {
                    <p>No hay información del usuario para mostrar.</p>
                }
              </div>
            </div>
          </div>
          <div class="col-4">
            <button class="boton-miPerfil">Editar perfil</button>
            <a class="boton-miPerfil btn" asp-controller="Home" asp-action="EntradasCompradas">Ver entradas compradas</a>
            <a class="boton-miPerfil btn" asp-controller="Home" asp-action="EntradasPublicadas">Ver entradas publicadas</a>
            </div>
        </div>
      </div>

      <div class="container mt-4">
        <h3>Próximos eventos</h3>

        @if (ViewBag.ProximosEventos != null && ((List<Entrada>)ViewBag.ProximosEventos).Count > 0)
        {
            <div class="row g-3">
                @foreach (var entrada in (List<Entrada>)ViewBag.ProximosEventos)
                {
                    var evento = entrada.Evento;
                    if (evento == null) continue;

                    <div class="col-md-6">
                        <div class="card h-100">
                            @if (!string.IsNullOrWhiteSpace(evento.Imagen))
                            {
                                <img src="@Url.Content("~/img/" + evento.Imagen)" class="card-img-top" alt="@evento.Nombre" style="height: 220px; object-fit: cover;" />
                            }
                            <div class="card-body">
                                <h5 class="card-title">@evento.Nombre</h5>
                                <p class="mb-1"><strong>Fecha:</strong> @evento.Fecha.ToString("dd/MM/yyyy")</p>
                                <p class="mb-1"><strong>Lugar:</strong> @evento.Lugar</p>
                                <p class="mb-1"><strong>Precio:</strong> $@entrada.Precio</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No tenés entradas compradas para eventos próximos.</p>
        }
      </div>
    </main>
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
  </body>
</html>