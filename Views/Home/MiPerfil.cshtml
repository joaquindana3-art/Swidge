@{
    ViewData["Title"] = "Mi perfil";
    var usuario = ViewBag.Usuario as Swidge.Models.Usuario;
}

<div class="mi-perfil-page">
    <div class="mi-perfil-card">
        <div class="mi-perfil-header">
            <h2>Mi perfil</h2>
        </div>

        <div class="mi-perfil-content">
            <div class="mi-perfil-grid">
                <div class="mi-perfil-field">
                    <input type="text" value="@(usuario?.Nombre ?? "Nombre")" readonly />
                </div>

                <div class="mi-perfil-field">
                    <input type="text" value="@(usuario?.Apellido ?? "Apellido")" readonly />
                </div>

                <div class="mi-perfil-field mi-perfil-field-full">
                    <input type="email" value="@(usuario?.Mail ?? "email@ejemplo.com")" readonly />
                </div>

                <div class="mi-perfil-field mi-perfil-field-full">
                    <input type="text" value="@(usuario?.NombreUsuario ?? "usuario")" readonly />
                </div>

                <div class="mi-perfil-field mi-perfil-field-full">
                    <input type="text" value="@(usuario?.Ciudad ?? "Ciudad")" readonly />
                </div>

                <div class="mi-perfil-field mi-perfil-field-full">
                    <input type="text" value="@(usuario?.FechaNacimiento != null && usuario.FechaNacimiento != default ? usuario.FechaNacimiento.ToString("dd/MM/yyyy") : "Fecha de nacimiento")" readonly />
                </div>

                <div class="mi-perfil-field mi-perfil-field-large">
                    <input type="text" value="@(usuario?.DNI > 0 ? usuario.DNI.ToString() : "DNI")" readonly />
                </div>

                <div class="mi-perfil-bridge">
                    <img class="mi-perfil-bridge-logo" src="~/img/logoSwidgeNegroTransparente.png" alt="Swidge" />
                </div>
            </div>

            <div class="mi-perfil-actions">
                <button type="button" class="mi-perfil-action-btn">Editar perfil</button>
                <a class="mi-perfil-action-btn" asp-controller="Home" asp-action="EntradasCompradas">Ver entradas compradas</a>
                <a class="mi-perfil-action-btn" asp-controller="Home" asp-action="EntradasPublicadas">Ver entradas publicadas</a>
                <a class="mi-perfil-action-btn" asp-controller="Home" asp-action="CambiarContraseña">Cambiar contraseña</a>
            </div>
        </div>
    </div>
</div>