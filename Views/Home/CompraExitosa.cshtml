@{
    Layout = null;

    var entrada = ViewBag.Entrada as Swidge.Models.Entrada ?? new Swidge.Models.Entrada();
    var evento = ViewBag.Evento as Swidge.Models.Evento ?? entrada.Evento ?? new Swidge.Models.Evento();
    var vendedor = ViewBag.Vendedor as Swidge.Models.Usuario ?? entrada.Vendedor ?? new Swidge.Models.Usuario();

    var imagenEvento = string.IsNullOrWhiteSpace(evento.Imagen)
        ? Url.Content("~/img/default-event.jpg")
        : Url.Content("~/img/" + evento.Imagen);

    var numeroOrden = entrada.ID > 0 ? entrada.ID.ToString() : "-";
    var nombreVendedor = !string.IsNullOrWhiteSpace(vendedor.Nombre) || !string.IsNullOrWhiteSpace(vendedor.Apellido)
        ? $"{vendedor.Nombre} {vendedor.Apellido}".Trim()
        : (!string.IsNullOrWhiteSpace(vendedor.NombreUsuario) ? vendedor.NombreUsuario : "-");
    var fechaEvento = evento.Fecha != default ? evento.Fecha.ToString("dd / MM / yyyy") : "-";
    var nombreEvento = !string.IsNullOrWhiteSpace(evento.Nombre) ? evento.Nombre : "-";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Compra exitosa</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="compra-exitosa-page">
    <section class="compra-hero" aria-label="Compra exitosa">
        <div class="compra-check" aria-hidden="true"></div>
    </section>

    <main class="compra-wrap">
        <div class="compra-grid">
            <div>
                <h1 class="compra-title">Compra exitosa</h1>

                <p class="compra-line"><strong>Número de orden:</strong> #@numeroOrden</p>
                <p class="compra-line"><strong>Nombre del vendedor:</strong> @nombreVendedor</p>
                <p class="compra-line"><strong>Fecha del evento confirmada :</strong> @fechaEvento</p>
                <p class="compra-line"><strong>Nombre del evento&nbsp;&nbsp;:</strong> @nombreEvento</p>
            </div>

            <div>
                <img src="@imagenEvento" alt="@nombreEvento" class="compra-image" />
                <div class="compra-actions">
                    <a class="compra-btn" href="@Url.Action("EntradasCompradas", "Home")">Ver entradas</a>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
