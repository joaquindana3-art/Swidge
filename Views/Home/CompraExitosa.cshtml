@{
    ViewData["Title"] = "Compra exitosa";

    Swidge.Models.Entrada entrada = ViewBag.Entrada as Swidge.Models.Entrada ?? new Swidge.Models.Entrada();
    Swidge.Models.Evento evento = ViewBag.Evento as Swidge.Models.Evento ?? entrada.Evento ?? new Swidge.Models.Evento();
    Swidge.Models.Usuario vendedor = ViewBag.Vendedor as Swidge.Models.Usuario ?? entrada.Vendedor ?? new Swidge.Models.Usuario();
    Swidge.Models.Ubicacion ubicacion = ViewBag.Ubicacion as Swidge.Models.Ubicacion ?? entrada.Ubicacion ?? new Swidge.Models.Ubicacion();

    string imagenEvento = string.IsNullOrWhiteSpace(evento.Imagen)
        ? Url.Content("~/img/default-event.jpg")
        : Url.Content("~/img/" + evento.Imagen);

    string numeroOrden = entrada.ID > 0 ? entrada.ID.ToString() : "-";
    string nombreVendedor = !string.IsNullOrWhiteSpace(vendedor.Nombre) || !string.IsNullOrWhiteSpace(vendedor.Apellido)
        ? $"{vendedor.Nombre} {vendedor.Apellido}".Trim()
        : (!string.IsNullOrWhiteSpace(vendedor.NombreUsuario) ? vendedor.NombreUsuario : "-");
    string usuarioVendedor = !string.IsNullOrWhiteSpace(vendedor.NombreUsuario) ? vendedor.NombreUsuario : "-";
    string fechaEvento = evento.Fecha != default ? evento.Fecha.ToString("dd / MM / yyyy") : "-";
    string nombreEvento = !string.IsNullOrWhiteSpace(evento.Nombre) ? evento.Nombre : "-";
    string ubicacionTexto = !string.IsNullOrWhiteSpace(ubicacion.NombreSector)
        ? $"{ubicacion.NombreSector}{(ubicacion.Fila.HasValue ? $", fila {ubicacion.Fila.Value}" : "")}{(ubicacion.Asiento.HasValue ? $", asiento {ubicacion.Asiento.Value}" : "")}"
        : "-";
    string precio = entrada.Precio > 0 ? entrada.Precio.ToString("N0") : "0";
}

<div class="compra-exitosa-page">
    <section class="compra-hero" aria-label="Compra exitosa">
        <div class="compra-check" aria-hidden="true"></div>
    </section>

    <main class="compra-wrap">
        <div class="compra-grid">
            <div>
                <h1 class="compra-title">Compra exitosa</h1>

                <p class="compra-line"><strong>Número de orden:</strong> #@numeroOrden</p>
                <p class="compra-line"><strong>Nombre del vendedor:</strong> @nombreVendedor</p>
                <p class="compra-line"><strong>Usuario vendedor:</strong> @usuarioVendedor</p>
                <p class="compra-line"><strong>Fecha del evento confirmada :</strong> @fechaEvento</p>
                <p class="compra-line"><strong>Nombre del evento&nbsp;&nbsp;:</strong> @nombreEvento</p>
                <p class="compra-line"><strong>Ubicación:</strong> @ubicacionTexto</p>
                <p class="compra-line"><strong>Precio:</strong> $@precio</p>
            </div>

            <div>
                <img src="@imagenEvento" alt="@nombreEvento" class="compra-image" onerror="this.onerror=null;this.src='@Url.Content("~/img/default-event.jpg")';" />
                <div class="compra-actions">
                    <a class="compra-btn" href="@Url.Action("EntradasCompradas", "Home")">Ver entradas</a>
                </div>
            </div>
        </div>
    </main>
</div>
