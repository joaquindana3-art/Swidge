@{
    Layout = "_Layout";
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swidge</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page-body">
    <main class="login-page">
        <section class="login-card" aria-labelledby="login-title">
            <div class="login-card__header">
                <h1 id="login-title">INICIA SESIÓN EN SWIDGE</h1>
            </div>

            <div class="login-card__body">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="login-alert" id="error-servidor">@ViewBag.ErrorMessage</div>
                }

                <form class="login-form" method="post" action="@Url.Action("IniciarSesion", "Session")" onsubmit="return validarLogin();" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="login-field">
                        <input type="text" id="usuario" name="usuario" maxlength="50" autocomplete="username" placeholder="Nombre de usuario" />
                    </div>

                    <div class="login-field">
                        <input type="password" id="contrasena" name="contrasena" maxlength="72" autocomplete="current-password" placeholder="Contraseña" />
                    </div>

                    <div class="login-forgot">
                        <a href="@Url.Action("OlvideMiContraseña", "Session")">¿Olvidaste tu contraseña?</a>
                    </div>

                    <div id="fb-login" class="login-feedback"></div>
                    <div>@ViewBag.ErrorMessage</div>
                    <button type="submit" class="login-submit" href="@Url.Action("IniciarSesion", "Session")">Iniciar sesión</button>

                    <img class="login-brand" src="~/img/letrasSwidge.png" alt="Swidge" />
                </form>
            </div>
        </section>

        <div class="login-divider" aria-hidden="true">o</div>
            <p class="login-register">
                ¿No tenés cuenta? <a href="@Url.Action("Registrarse", "Session")">Registrate</a>
            </p>
        </div>
    </main>

    <script src="@Url.Content("~/js/login.js")"></script>
</body>
</html>
