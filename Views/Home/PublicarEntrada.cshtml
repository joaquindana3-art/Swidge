<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
  </head>
  <body>
    <main>
    <h3>Vende sin complicaciones</h3>
    <h1>Publica tu entrada</h1>
    <form action='@Url.Action("PublicarEntrada", "Home")' method="post" enctype="multipart/form-data" onsubmit="return validarPublicacion();" novalidate>
    <div class="form-field">
        <label for="nombreEvento" class="form-label">Nombre del evento</label>
        <input type="text" class="form-control" id="nombreEvento" placeholder="nombre del evento" name="nombreEvento">
    </div>
    <div>
        <label for="categoriaEvento" class="form-label">Categoría</label>
        <select class="form-control form-control-sm" id="categoriaEvento" name="categoriaEvento">
            <option value="">Selecciona la categoria de tu evento</option>
            <option value="concierto">Concierto</option>
            <option value="teatro">Teatro</option>
            <option value="deportivo">Deportivo</option>
            <option value="cultural">Cultural</option>
            <option value="festivales">Festivales</option>
            <option value="otros">Otros</option>
        </select>
    </div>
    <div>
        <label for="fechaEvento" class="form-label">Ingresa la fecha y hora de tu evento</label>
        <input type="datetime-local" class="form-control" id="fechaEvento" name="fechaEvento" aria-label="Date and time picker" value="2026-02-24T13:00">
    </div>
    <div class="form-field">
        <label for="ciudadEvento" class="form-label">Ciudad del evento</label>
        <input type="text" class="form-control" id="ciudadEvento" placeholder="ciudad del evento" name="ciudadEvento">
    </div>
    <div class="form-field">
        <label for="direccionEvento" class="form-label">Dirección del evento</label>
        <input type="text" class="form-control" id="direccionEvento" placeholder="dirección del evento" name="direccionEvento">
    </div>
    <div class="form-field">
        <label for="precioEntrada" class="form-label">Precio de la entrada</label>
        <input type="text" class="form-control" id="precioEntrada" placeholder="precio de la entrada" name="precioEntrada">
    </div>
    <div class="form-field">
        <label for="cantidadEntradas" class="form-label">Cantidad de entradas</label>
        <input type="text" class="form-control" id="cantidadEntradas" placeholder="cantidad de entradas" name="cantidadEntradas">
    </div>
    <div class="form-field">
        <label for="imagenEvento" class="form-label">Imagen del evento</label>
        <input type="file" class="form-control" id="imagenEvento" name="imagenEvento">
    </div>
    <div class="form-field">
        <label for="comprobante" class="form-label">Comprobante</label>
        <input type="file" class="form-control" id="comprobante" name="comprobante">
    </div>
    <div class="form-field">
        <label for="descripcionEvento" class="form-label">Descripción</label>
        <textarea class="form-control" id="descripcionEvento" rows="3" name="descripcionEvento"></textarea>
        <div class="form-text">
           Hace una breve descripción de tu evento, para que los compradores tengan una idea de lo que se trata.
        </div>
    </div>
    <div class="form-field mb-3">
        <input type="checkbox" id="aceptaTerminos" class="check is-invalid" name="aceptaTerminos" required>
        <label for="aceptaTerminos">Acepto los términos y condiciones</label>
        <div class="invalid-feedback">Debes aceptar antes de enviar.</div>
    </div>

    <div id="fb-publicacion" class="mt-2 mb-3" style="color: red; display: none;"></div>

    <input type="submit" value="Publicar" class="btn btn-primary">
    <input type="reset" value="Cancelar" class="btn btn-secondary">
    </form>
    </main>
    <script src ="/js/publicarEntrada.js"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
  </body>
</html>
