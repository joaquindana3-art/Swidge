@model Swidge.Models.Entrada

@{
    var entrada = Model ?? new Swidge.Models.Entrada();
    var evento = entrada.Evento ?? new Swidge.Models.Evento();
    var ubicacion = entrada.Ubicacion ?? new Swidge.Models.Ubicacion();

    var fecha = evento.Fecha != default ? evento.Fecha.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-AR")) : "Fecha por confirmar";
    var hora = evento.Fecha != default ? evento.Fecha.ToString("HH:mm") + "hs" : "Hora por confirmar";

    var lugar = !string.IsNullOrWhiteSpace(evento.Lugar)
        ? evento.Lugar
        : !string.IsNullOrWhiteSpace(ubicacion.NombreLugar)
            ? ubicacion.NombreLugar
            : "Lugar por confirmar";

    var sector = !string.IsNullOrWhiteSpace(ubicacion.NombreSector) ? ubicacion.NombreSector : "Sin sector";
    var fila = ubicacion.Fila.HasValue ? $"Fila {ubicacion.Fila.Value}" : null;
    var asiento = ubicacion.Asiento.HasValue ? $"Asiento {ubicacion.Asiento.Value}" : null;

    var ubicacionTexto = string.Join(" / ", new[] { sector, fila, asiento }.Where(x => !string.IsNullOrWhiteSpace(x)));
    if (string.IsNullOrWhiteSpace(ubicacionTexto))
    {
        ubicacionTexto = "Ubicación por confirmar";
    }

    var precioEntrada = entrada.Precio > 0 ? entrada.Precio : 0m;
    var cargoServicio = precioEntrada * 0.10m;
    var precioFormateado = $"${precioEntrada:N0} ARS";
    var cargoFormateado = $"(${cargoServicio:N0} de Cargo por servicio)";

    var qrTexto = entrada.ID > 0 ? $"SWIDGE-{entrada.ID}" : "SWIDGE-ENTRADA";
    var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=520x520&data={Uri.EscapeDataString(qrTexto)}";
}

<div class="confirm-detail-shell">
    <h1 class="confirm-detail-title">Confirme los datos de su entrada</h1>

    <div class="confirm-detail-grid">
        <div class="confirm-detail-info-box">
            <div class="confirm-detail-cell">
                <div class="detail-icon-wrap">
                    <span class="detail-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2zm13 8H4v10h16V10zm-2-4H5v2h14V6z" /></svg>
                    </span>
                </div>
                <div class="detail-text">
                    <div class="detail-label">Fecha y Hora</div>
                    <div class="detail-value">@fecha</div>
                    <div class="detail-subvalue">@hora</div>
                </div>
            </div>

            <div class="confirm-detail-cell">
                <div class="detail-icon-wrap">
                    <span class="detail-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8zm0 10.5A2.5 2.5 0 1 1 12 7a2.5 2.5 0 0 1 0 5.5z" /></svg>
                    </span>
                </div>
                <div class="detail-text">
                    <div class="detail-label">Lugar</div>
                    <div class="detail-value">@lugar</div>
                    @if (!string.IsNullOrWhiteSpace(evento.Provincia))
                    {
                        <div class="detail-subvalue">@evento.Provincia</div>
                    }
                </div>
            </div>

            <div class="confirm-detail-cell">
                <div class="detail-icon-wrap">
                    <span class="detail-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M19 7h-1V5a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2zm-7 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zm-5-3.5V5h12v2H7z" /></svg>
                    </span>
                </div>
                <div class="detail-text">
                    <div class="detail-label">Ubicación / Sector</div>
                    <div class="detail-value">@ubicacionTexto</div>
                    @if (!string.IsNullOrWhiteSpace(evento.Nombre))
                    {
                        <div class="detail-subvalue">@evento.Nombre</div>
                    }
                </div>
            </div>

            <div class="confirm-detail-cell">
                <div class="detail-icon-wrap">
                    <span class="detail-icon detail-icon-money" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 1 3 3v1.07A4.99 4.99 0 0 1 19.93 11H22v2h-2.07A4.99 4.99 0 0 1 15 18.93V20h-2v-1.07A4.99 4.99 0 0 1 6.07 13H4v-2h2.07A4.99 4.99 0 0 1 9 5.07V4a3 3 0 0 1 3-3zm0 4.25A2.75 2.75 0 0 0 9.25 8v1.5h5.5V8A2.75 2.75 0 0 0 12 5.25zm0 6.75a2.75 2.75 0 0 0 2.75 2.75v-1.5h-5.5v1.5A2.75 2.75 0 0 0 12 12z" /></svg>
                    </span>
                </div>
                <div class="detail-text">
                    <div class="detail-label">Precio</div>
                    <div class="detail-value">@precioFormateado</div>
                    <div class="detail-subvalue">@cargoFormateado</div>
                </div>
            </div>
        </div>

        <div class="confirm-detail-qr-box">
            <div class="qr-shell">
                <img src="@qrUrl" alt="Código QR de la entrada" class="qr-image" />
            </div>
        </div>
    </div>

    <div class="confirm-detail-actions">
        <button class="confirm-detail-btn" type="button">Confirmar y publicar entrada</button>
    </div>
</div>
