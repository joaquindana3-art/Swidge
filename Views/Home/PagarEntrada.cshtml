@model Swidge.Models.Entrada

@{
    ViewData["Title"] = "Pagar entrada";
    var evento = Model?.Evento ?? new Swidge.Models.Evento();
    var vendedor = Model?.Vendedor ?? new Swidge.Models.Usuario();
    var ubicacion = Model?.Ubicacion ?? new Swidge.Models.Ubicacion();

    var imagenEvento = string.IsNullOrWhiteSpace(evento.Imagen)
        ? Url.Content("~/img/default-event.jpg")
        : Url.Content("~/img/" + evento.Imagen);

    var precio = Model?.Precio > 0 ? Model.Precio.ToString("N0") : "0";
    var fecha = evento.Fecha != default ? evento.Fecha.ToString("ddd, dd MMM, HH:mm") : "Fecha por confirmar";
    var lugar = string.IsNullOrWhiteSpace(evento.Lugar) ? "Lugar por confirmar" : evento.Lugar;
    var ubicacionTexto = !string.IsNullOrWhiteSpace(ubicacion.NombreSector)
        ? $"{ubicacion.NombreSector}{(ubicacion.Fila.HasValue ? $", fila {ubicacion.Fila.Value}" : "")}{(ubicacion.Asiento.HasValue ? $", asiento {ubicacion.Asiento.Value}" : "")}"
        : "Ubicación por confirmar";
}

<div class="checkout-shell">
    <div class="checkout-panel">
        <form id="checkoutForm" method="post" action="@Url.Action("CompraExitosa", "Home")" data-compra-exitosa-url="@Url.Action("CompraExitosa", "Home", new { id = Model?.ID ?? 0 })">
            <input type="hidden" id="entradaId" name="id" value="@Model?.ID" />
            <div class="checkout-form-wrap">
                <div class="checkout-payments" role="radiogroup" aria-label="Método de pago">
                    <label class="checkout-payment-option">
                        <input type="radio" name="metodoPago" value="Tarjeta" checked />
                        <span class="checkout-payment-box">
                            <span class="checkout-payment-logo checkout-card">T</span>
                            <span>Tarjeta de crédito o débito</span>
                        </span>
                    </label>

                    <label class="checkout-payment-option">
                        <input type="radio" name="metodoPago" value="Mercado pago" />
                        <span class="checkout-payment-box">
                            <span class="checkout-payment-logo checkout-mercado">M</span>
                            <span>Mercado pago</span>
                        </span>
                    </label>

                    <label class="checkout-payment-option">
                        <input type="radio" name="metodoPago" value="Paypal" />
                        <span class="checkout-payment-box">
                            <span class="checkout-payment-logo checkout-paypal">P</span>
                            <span>Paypal</span>
                        </span>
                    </label>

                    <label class="checkout-payment-option">
                        <input type="radio" name="metodoPago" value="Google Pay" />
                        <span class="checkout-payment-box">
                            <span class="checkout-payment-logo checkout-google">G</span>
                            <span>Google Pay</span>
                        </span>
                    </label>

                    <label class="checkout-payment-option">
                        <input type="radio" name="metodoPago" value="Apple Pay" />
                        <span class="checkout-payment-box">
                            <span class="checkout-payment-logo checkout-apple"></span>
                            <span>Apple Pay</span>
                        </span>
                    </label>

                    <label class="checkout-payment-option">
                        <input type="radio" name="metodoPago" value="Ualá" />
                        <span class="checkout-payment-box">
                            <span class="checkout-payment-logo checkout-uala">U</span>
                            <span>Ualá</span>
                        </span>
                    </label>
                </div>

                <div class="checkout-card-fields" data-payment-type="Tarjeta">
                    <div class="checkout-field-grid">
                        <div class="checkout-field">
                            <input id="numeroTarjeta" type="text" inputmode="numeric" autocomplete="cc-number" placeholder="Número de tarjeta" maxlength="19" />
                        </div>

                        <div class="checkout-input-row">
                            <div class="checkout-field">
                                <input id="cvvTarjeta" type="text" inputmode="numeric" autocomplete="cc-csc" placeholder="Código de seguridad (CVV)" maxlength="4" />
                            </div>
                            <div class="checkout-field">
                                <input id="vencimientoTarjeta" type="text" inputmode="numeric" autocomplete="cc-exp" placeholder="Fecha de vencimiento (MM/AA)" maxlength="5" />
                            </div>
                        </div>

                        <div class="checkout-field">
                            <input id="titularTarjeta" type="text" autocomplete="cc-name" placeholder="Nombre del titular" maxlength="50" />
                        </div>

                        <div class="checkout-field">
                            <input id="direccionFacturacion" type="text" autocomplete="address-line1" placeholder="Dirección de facturación" maxlength="80" />
                        </div>
                    </div>
                </div>

                <label class="checkout-terms" for="aceptaDevolucion">
                    <input id="aceptaDevolucion" type="checkbox" name="aceptaDevolucion" required />
                    <span>¿Acepta los términos de devolución?</span>
                </label>

                <button id="confirmarCompra" type="submit" class="checkout-confirm-btn" disabled>Confirmar</button>
            </div>
        </form>
    </div>

    <div class="checkout-right-panel">
        <div class="checkout-event-card">
            <div class="checkout-event-poster" style="background: url('@imagenEvento') center/cover no-repeat;">
                <div class="checkout-poster-glow"></div>
            </div>
        </div>

        <div class="checkout-event-copy">
            <strong>@evento.Nombre</strong><br />
            Fecha: @fecha<br />
            Lugar: @lugar<br />
            Ubicación: @ubicacionTexto<br />
            <span class="checkout-price">Precio: $@precio</span>
        </div>

        <div class="checkout-policy-box">
            Lea la política de devolución
        </div>
    </div>
</div>

<script src="~/js/pagarEntrada.js" defer></script>
