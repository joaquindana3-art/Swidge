@{
    ViewData["Title"] = "Inicio";
}


        <aside class="filters-panel">
            <div class="filters-panel__header">
                <span class="filters-panel__icon">⌕</span>
                <h2>Filtros</h2>
                <button type="button" class="filters-panel__clear">Limpiar</button>
            </div>

            <div class="filters-panel__section">
                <label for="cityFilter">Ciudad</label>
                <select id="cityFilter" class="filters-panel__select">
                    <option selected>Buenos Aires</option>
                    <option>Miami</option>
                    <option>Brasilia</option>
                    <option>Lima</option>
                </select>
            </div>

            <div class="filters-panel__section">
                <label>Categoría</label>
                <div class="filters-panel__categories">
                    <label class="filters-chip filters-chip--active"><input type="checkbox" checked /> Todo</label>
                    <label class="filters-chip"><input type="checkbox" /> Conciertos</label>
                    <label class="filters-chip"><input type="checkbox" /> Deportes</label>
                    <label class="filters-chip"><input type="checkbox" /> Teatros</label>
                </div>
            </div>

            <div class="filters-panel__section">
                <div class="filters-panel__price-head">
                    <label for="priceRange">Precio máximo</label>
                    <span>$150</span>
                </div>
                <input id="priceRange" class="filters-panel__range" type="range" min="0" max="150" value="150" />
                <div class="filters-panel__price-values">
                    <span>$0</span>
                    <span>$150</span>
                </div>
            </div>

            <label class="filters-panel__verified">
                <span>Solo vendedores verificados</span>
                <input type="checkbox" checked />
            </label>
        </aside>
    </section>
</div>
