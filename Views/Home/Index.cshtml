@{
    ViewData["Title"] = "Compra";
    var entradas = ViewBag.listaEntradas as List<Swidge.Models.Entrada> ?? new List<Swidge.Models.Entrada>();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
<script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
<!-- Banner Promocional -->
<section class = "carrusel">
<div id="carouselExample" class="carousel slide">
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="/img/carrusel1.jpg" class="d-block w-100" alt="...">
    </div>
    <div class="carousel-item">
      <img src="/img/carrusel2.jpg" class="d-block w-100" alt="...">
    </div>
    <div class="carousel-item">
      <img src="/img/carrusel3.jpg" class="d-block w-100" alt="...">
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
</section>

<div class="container-fluid px-4">
    <div class="row justify-content: center mb-4">
        <div class="col-md-8 mx-auto">
            <div class="p-2 d-flex align-items-center justify-content-between" style="background-color: #5f82f7; border-radius: 6px;">
                <div class="d-flex align-items-center gap-2 ps-2 text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                    <span class="fw-bold fs-5">Consultar</span>
                </div>
                <img src="~/img/letrasSwidge.png" alt="Swidge Logo" class="letras"/>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 col-md-7">
            @if (entradas != null && entradas.Count > 0)
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var item in entradas)
                    {
                        var evento = item.Evento ?? new Swidge.Models.Evento { Nombre = "Evento", Lugar = "Lugar", Fecha = DateTime.Now };
                        var imagenEvento = string.IsNullOrEmpty(evento.Imagen)
                            ? Url.Content("~/img/default-event.jpg")
                            : Url.Content("~/img/" + evento.Imagen);

                        <div class="col">
                            <div class="card h-100 border-0 p-3" style="background-color: #a4bafa; border-radius: 8px;">
                                <img src="@imagenEvento"
                                     class="card-img-top mb-2"
                                     alt="@(evento.Nombre)"
                                     style="height: 170px; object-fit: cover; border-radius: 4px;" />
                                
                                <div class="card-body p-0 d-flex flex-column justify-content-between">
                                    <div>
                                        <p class="text-danger fw-bold mb-1" style="font-size: 0.75rem; text-transform: uppercase;">
                                            @(evento.Fecha != default ? evento.Fecha.ToString("dddd dd/MM").ToUpper() : "PROXIMAMENTE")
                                        </p>
                                        <h5 class="card-title fw-extrabold mb-1" style="color: #10233d; font-size: 1.05rem;">
                                            @evento.Nombre
                                        </h5>
                                        <p class="text-muted mb-2" style="font-size: 0.8rem;">
                                            📍 @(string.IsNullOrEmpty(evento.Lugar) ? "Lugar por confirmar" : evento.Lugar)
                                        </p>
                                    </div>
                                    
                                    <div class="d-flex align-items-center justify-content-between mt-2 pt-2">
                                        <span class="fw-bold text-danger fs-5">$@item.Precio.ToString("N0")</span>
                                        <a href="@Url.Action("DetalleEntrada", "Home", new { id = item.ID })" 
                                           class="btn btn-sm text-white px-3 fw-bold" 
                                           style="background-color: #5f82f7; border-radius: 5px;">
                                            Comprar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4 class="text-muted">No hay entradas disponibles en este momento.</h4>
                </div>
            }
        </div>
        <div class="col-lg-4 col-md-5 mt-4 mt-md-0">
            <div class="p-4 text-white" style="background-color: #5f82f7; border-radius: 10px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                        <h4 class="m-0 fw-bold">Filtros</h4>
                    </div>
                    <a href="#" class="text-white text-decoration-underline" style="font-size: 0.85rem;">Limpiar</a>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">Ciudad</label>
                    <select class="form-select border-0">
                        <option selected>Buenos Aires</option>
                        <option value="1">Córdoba</option>
                        <option value="2">Rosario</option>
                        <option value="3">Mendoza</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">Categoría</label>
                    <div class="d-flex flex-column gap-2">
                        <button class="btn btn-light text-start fw-bold py-1" style="color: #274b9f;">✔ Todo</button>
                        <button class="btn btn-light text-start fw-bold py-1" style="color: #274b9f;">Conciertos</button>
                        <button class="btn btn-light text-start fw-bold py-1" style="color: #274b9f;">Deportes</button>
                        <button class="btn btn-light text-start fw-bold py-1" style="color: #274b9f;">Teatros</button>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between fw-bold mb-1">
                        <span>Precio máximo</span>
                        <span>$150</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold">$0</span>
                        <input type="range" class="form-range" min="0" max="150" value="150" />
                        <span class="fw-bold">$150</span>
                    </div>
                </div>
                <div class="form-check d-flex justify-content-between align-items-center ps-0">
                    <label class="form-check-label fw-bold" for="checkVerificados">
                        Solo vendedores verificados
                    </label>
                    <input class="form-check-input ms-auto" type="checkbox" id="checkVerificados" checked style="width: 1.3em; height: 1.3em;" />
                </div>
            </div>
        </div>
    </div>
</div>