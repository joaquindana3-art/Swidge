@{
    ViewData["Title"] = "Compra";

    List<Swidge.Models.Entrada> entradas = ViewBag.listaEntradas as List<Swidge.Models.Entrada> ?? new List<Swidge.Models.Entrada>();
    List<string> provincias = ViewBag.Ciudades as List<string> ?? new List<string>();
    List<string> categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    string provinciaSeleccionada = ViewBag.provinciaSeleccionada?.ToString() ?? ViewBag.ciudadSeleccionada?.ToString() ?? "Todos";
    string categoriaSeleccionada = ViewBag.categoriaSeleccionada?.ToString() ?? "Todos";
    decimal precioMaximo = ViewBag.precioMaximo != null ? Convert.ToDecimal(ViewBag.precioMaximo) : 0m;
    decimal precioMaximoBD = ViewBag.precioMaximoBD != null ? Convert.ToDecimal(ViewBag.precioMaximoBD) : 0m;
}
    <section class="section-carrusel">
        <div id="carouselExampleIndicators" class="carousel slide">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        
        <div class="carousel-inner">
            <div class="carousel-item active">
            <img src="~/img/carrusel1.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
            <img src="~/img/carrusel2.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
            <img src="~/img/carrusel3.jpg" class="d-block w-100" alt="...">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
        </div>
    </section>

    <div class="search-panel-wrapper">
        <div class="search-box">
            <span class="search-icon">🔎</span>
            <input id="eventSearchInput" type="text" placeholder="Evento, artista o equipo" aria-label="Buscar evento" autocomplete="off" />
            <div id="searchSuggestions" class="search-suggestions" aria-live="polite"></div>
        </div>
    </div>

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-lg-8 col-md-7" id="entradasContainer">
            @if (entradas.Count > 0)
            {
                foreach (var item in entradas)
                {
                    var evento = item.Evento;
                    if (evento == null)
                    {
                        evento = new Swidge.Models.Evento();
                        evento.Nombre = "Evento";
                        evento.Lugar = "Lugar";
                        evento.Fecha = DateTime.Now;
                    }

                    var imagen = "/img/default-event.jpg";
                    if (!string.IsNullOrEmpty(evento.Imagen))
                    {
                        imagen = "/img/" + evento.Imagen;
                    }

                    <div class="card mb-3 event-card" data-event-name="@evento.Nombre" data-event-lugar="@evento.Lugar" data-entry-id="@item.ID" id="entrada-@item.ID">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="@imagen" class="img-fluid h-100 w-100" style="object-fit: cover;" />
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <p class="text-danger fw-bold mb-1">@evento.Fecha.ToString("dddd dd/MM")</p>
                                    <h5 class="card-title">@evento.Nombre</h5>
                                    <p class="text-muted">📍 @evento.Lugar</p>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="fw-bold text-danger fs-5">$@item.Precio.ToString("N0")</span>
                                        <a href="@Url.Action("DetalleEntrada", "Home", new { id = item.ID })" class="btn btn-primary btn-sm">Comprar</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <h4>No hay entradas disponibles con los filtros seleccionados.</h4>
                </div>
            }
        </div>

        <div class="col-lg-4 col-md-5">
            <form id="filtrosForm" method="get" asp-action="Index" asp-controller="Home" class="p-4 border rounded bg-light">
                <h4 class="mb-3">Filtros</h4>

                <div class="mb-3">
                    <label class="form-label">Provincia</label>
                    <select name="provincia" class="form-select">
                        @foreach (var provincia in provincias)
                        {
                            if (provincia == provinciaSeleccionada)
                            {
                                <option value="@provincia" selected>@provincia</option>
                            }
                            else
                            {
                                <option value="@provincia">@provincia</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var categoria in categorias)
                        {
                            if (categoria == categoriaSeleccionada)
                            {
                                <button type="submit" name="categoria" value="@categoria" class="btn btn-primary text-start">
                                    @categoria
                                </button>
                            }
                            else
                            {
                                <button type="submit" name="categoria" value="@categoria" class="btn btn-light text-start">
                                    @categoria
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio máximo</label>
                    <div class="d-flex justify-content-between">
                        <span>$0</span>
                        <span id="precioSeleccionado">$@precioMaximo.ToString("N0")</span>
                    </div>

                    <input id="precioMaximoSlider"
                           type="range"
                           min="0"
                           max="100"
                           value="@((precioMaximoBD > 0 ? (precioMaximo / precioMaximoBD) * 100 : 0m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                           style="width: 100%;" />

                    <input type="hidden" id="precioMaximoReal" name="precioMaximo" value="@precioMaximo" />
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const form = document.getElementById('filtrosForm');
                        const slider = document.getElementById('precioMaximoSlider');
                        const hidden = document.getElementById('precioMaximoReal');
                        const label = document.getElementById('precioSeleccionado');

                        if (!slider || !hidden || !label) return;

                        const actualizarPrecio = () => {
                            const maxDb = Number(@precioMaximoBD);
                            const porcentaje = Number(slider.value || 0);
                            const valor = (porcentaje / 100) * maxDb;

                            hidden.value = valor.toFixed(0);
                            label.innerText = '$' + valor.toLocaleString('es-AR');
                        };

                        actualizarPrecio();

                        slider.addEventListener('input', function () {
                            actualizarPrecio();
                            if (form) {
                                form.submit();
                            }
                        });
                    });
                </script>

                <a href="@Url.Action("Index", "Home")" class="btn btn-link w-100 mt-2">Limpiar</a>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const input = document.getElementById('eventSearchInput');
        const suggestions = document.getElementById('searchSuggestions');
        const cards = Array.from(document.querySelectorAll('.event-card'));

        if (!input || !suggestions || cards.length === 0) return;

        const normalize = (value) =>
            (value ?? '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '');

        const applySearch = (query) => {
            const term = normalize(query.trim());

            cards.forEach((card) => {
                const name = normalize(card.dataset.eventName);
                const lugar = normalize(card.dataset.eventLugar);
                const match = !term || name.includes(term) || lugar.includes(term);
                card.style.display = match ? '' : 'none';
            });
        };

        const renderSuggestions = (query) => {
            const term = normalize(query.trim());

            if (!term) {
                suggestions.innerHTML = '';
                suggestions.classList.remove('show');
                return;
            }

            const matches = cards.filter((card) => {
                const name = normalize(card.dataset.eventName);
                const lugar = normalize(card.dataset.eventLugar);
                return name.includes(term) || lugar.includes(term);
            }).slice(0, 6);

            if (!matches.length) {
                suggestions.innerHTML = '<div class="search-empty">No se encontraron coincidencias</div>';
                suggestions.classList.add('show');
                return;
            }

            suggestions.innerHTML = matches.map((card) => `
                <button type="button" class="search-item" data-target="${card.id}">
                    ${card.dataset.eventName}
                </button>
            `).join('');
            suggestions.classList.add('show');

            suggestions.querySelectorAll('.search-item').forEach((button) => {
                button.addEventListener('click', function () {
                    const targetId = this.dataset.target;
                    const targetCard = document.getElementById(targetId);
                    if (targetCard) {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        targetCard.classList.add('search-highlight');
                        setTimeout(() => targetCard.classList.remove('search-highlight'), 1400);
                    }

                    input.value = button.textContent.trim();
                    applySearch(input.value);
                    suggestions.classList.remove('show');
                });
            });
        };

        input.addEventListener('input', function () {
            const value = this.value;
            applySearch(value);
            renderSuggestions(value);
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('.search-box')) {
                suggestions.classList.remove('show');
            }
        });
    });
</script>