@{
    ViewData["Title"] = "Compra";

    List<Swidge.Models.Entrada> entradas = ViewBag.listaEntradas as List<Swidge.Models.Entrada>;
    if (entradas == null)
    {
        entradas = new List<Swidge.Models.Entrada>();
    }

    List<string> ciudades = ViewBag.Ciudades as List<string>;
    if (ciudades == null)
    {
        ciudades = new List<string>();
    }

    List<string> categorias = ViewBag.Categorias as List<string>;
    if (categorias == null)
    {
        categorias = new List<string>();
    }

    string ciudadSeleccionada = "Todos";
    if (ViewBag.ciudadSeleccionada != null)
    {
        ciudadSeleccionada = ViewBag.ciudadSeleccionada.ToString();
    }

    string categoriaSeleccionada = "Todos";
    if (ViewBag.categoriaSeleccionada != null)
    {
        categoriaSeleccionada = ViewBag.categoriaSeleccionada.ToString();
    }

    decimal precioMaximo = 0m;
    if (ViewBag.precioMaximo != null)
    {
        precioMaximo = Convert.ToDecimal(ViewBag.precioMaximo);
    }

    decimal precioMaximoBD = 0m;
    if (ViewBag.precioMaximoBD != null)
    {
        precioMaximoBD = Convert.ToDecimal(ViewBag.precioMaximoBD);
    }

    bool soloVerificados = false;
    if (ViewBag.soloVerificados != null)
    {
        soloVerificados = (bool)ViewBag.soloVerificados;
    }
}

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-lg-8 col-md-7">
            @if (entradas.Count > 0)
            {
                foreach (var item in entradas)
                {
                    var evento = item.Evento;
                    if (evento == null)
                    {
                        evento = new Swidge.Models.Evento();
                        evento.Nombre = "Evento";
                        evento.Lugar = "Lugar";
                        evento.Fecha = DateTime.Now;
                    }

                    var imagen = "/img/default-event.jpg";
                    if (!string.IsNullOrEmpty(evento.Imagen))
                    {
                        imagen = "/img/" + evento.Imagen;
                    }

                    <div class="card mb-3">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="@imagen" class="img-fluid h-100 w-100" style="object-fit: cover;" />
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <p class="text-danger fw-bold mb-1">@evento.Fecha.ToString("dddd dd/MM")</p>
                                    <h5 class="card-title">@evento.Nombre</h5>
                                    <p class="text-muted">📍 @evento.Lugar</p>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="fw-bold text-danger fs-5">$@item.Precio.ToString("N0")</span>
                                        <a href="@Url.Action("DetalleEntrada", "Home", new { id = item.ID })" class="btn btn-primary btn-sm">Comprar</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <h4>No hay entradas disponibles con los filtros seleccionados.</h4>
                </div>
            }
        </div>

        <div class="col-lg-4 col-md-5">
            <form method="get" asp-action="Index" asp-controller="Home" class="p-4 border rounded bg-light">
                <h4 class="mb-3">Filtros</h4>

                <div class="mb-3">
                    <label class="form-label">Ciudad</label>
                    <select name="ciudad" class="form-select">
                        @foreach (var ciudad in ciudades)
                        {
                            if (ciudad == ciudadSeleccionada)
                            {
                                <option value="@ciudad" selected>@ciudad</option>
                            }
                            else
                            {
                                <option value="@ciudad">@ciudad</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var categoria in categorias)
                        {
                            if (categoria == categoriaSeleccionada)
                            {
                                <button type="submit" name="categoria" value="@categoria" class="btn btn-primary text-start">
                                    @categoria
                                </button>
                            }
                            else
                            {
                                <button type="submit" name="categoria" value="@categoria" class="btn btn-light text-start">
                                    @categoria
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio máximo</label>
                    <div class="d-flex justify-content-between">
                        <span>$0</span>
                        <span id="precioSeleccionado">$@precioMaximo.ToString("N0")</span>
                    </div>
                    <input type="range"
                           name="precioMaximo"
                           class="form-range"
                           min="0"
                           max="@precioMaximoBD"
                           value="@precioMaximo"
                           oninput="document.getElementById('precioSeleccionado').innerText = '$' + this.value" />
                </div>

                <div class="form-check mb-3">
                    @if (soloVerificados)
                    {
                        <input class="form-check-input" type="checkbox" id="soloVerificados" name="soloVerificados" value="true" checked />
                    }
                    else
                    {
                        <input class="form-check-input" type="checkbox" id="soloVerificados" name="soloVerificados" value="true" />
                    }
                    <label class="form-check-label" for="soloVerificados">Solo vendedores verificados</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Aplicar filtros</button>
                <a href="@Url.Action("Index", "Home")" class="btn btn-link w-100 mt-2">Limpiar</a>
            </form>
        </div>
    </div>
</div>