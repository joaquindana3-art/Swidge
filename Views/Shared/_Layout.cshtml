<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swidge</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Swidge.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="swidge-header">
        <a class="swidge-brand" asp-controller="Home" asp-action="Index" aria-label="Swidge inicio">
            <img src="@Url.Content("~/img/letrasSwidge.png")" alt="Swidge" />
        </a>

        <nav class="swidge-nav" aria-label="Navegación principal">
            <a class="swidge-link swidge-link--primary" asp-controller="Home" asp-action="EntradasPublicadas">Mis entradas</a>
            <a class="swidge-link swidge-link--secondary" asp-controller="Home" asp-action="Ayuda">Ayuda</a>
            <a class="swidge-link swidge-link--secondary" asp-controller="Home" asp-action="Landing">Sobre nosotros</a>
            <a class="swidge-link swidge-link--danger" asp-controller="Home" asp-action="PublicarEntrada">Publicar</a>
            <a class="swidge-link swidge-link--blue" asp-controller="Home" asp-action="Index">Explorar entradas</a>
        </nav>

        @if (Context.Session.GetInt32("DNI") != null)
        {
            <div class="swidge-user-wrap dropdown">
                <button class="swidge-user-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú del usuario">
                    <img src="@Url.Content("~/img/usuario.png")" alt="Usuario" />
                </button>
                <span class="swidge-username">@Context.Session.GetString("NombreUsuario")</span>
                <ul class="dropdown-menu dropdown-menu-end swidge-profile-menu">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="MiPerfil">Mi perfil</a></li>
                    <li><a class="dropdown-item" asp-controller="Session" asp-action="CerrarSesion">Cerrar sesión</a></li>
                </ul>
            </div>
        }
        else
        {
            <div class="swidge-user-wrap dropdown">
                <button class="swidge-user-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de sesión">
                    <img src="@Url.Content("~/img/usuario.png")" alt="Usuario" />
                </button>
                <ul class="dropdown-menu dropdown-menu-end swidge-profile-menu">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="IniciarSesion">Iniciar sesión</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Registrarse">Registrarse</a></li>
                </ul>
            </div>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Swidge - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
