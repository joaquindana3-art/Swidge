<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swidge</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Swidge.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="topbar">
            <div class="nav-group nav-left">
                <a class="icon-link back-link" href="#" aria-label="Volver atrás"><img class="flecha" src="~/img/flechaAtras.png" alt="volverAtras"></a>
                <a class="pill-link" asp-controller="Home" asp-action="Index">Compra</a>
                <a class="pill-link" asp-controller="Home" asp-action="PublicarEntrada">Publicar entrada</a>
                <a class="pill-link" asp-controller="Home" asp-action="Ayuda">Ayuda</a>
            </div>

            <a class="nav-logo" asp-controller="Home" asp-action="Index" aria-label="Swidge inicio">
                <img class="letras" src="~/img/letrasSwidge.png" alt="Logo Swidge">
            </a>

            <div class="nav-group nav-right">
                <a class="pill-link wide" asp-controller="Home" asp-action="EntradasPublicadas">Mis entradas publicadas</a>
                <a class="pill-link wide" asp-controller="Home" asp-action="EntradasCompradas">Mis entradas compradas</a>

                <div class="profile-user-wrap">
                    <div class="dropdown profile-dropdown">
                        <button class="btn profile-dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img class="usuario" src="@Url.Content("~/img/usuario.png")" alt="Usuario">
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="MiPerfil">Mi perfil</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="IniciarSesion">Iniciar sesión</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Registrarse">Registrarse</a></li>
                            <li><a class="dropdown-item" asp-controller="Session" asp-action="CerrarSesion">Cerrar sesión</a></li>
                        </ul>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Context.Session.GetString("NombreUsuario")))
                    {
                        <span class="profile-username">@Context.Session.GetString("NombreUsuario")</span>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Swidge - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
