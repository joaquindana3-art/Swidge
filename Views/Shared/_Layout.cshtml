<!DOCTYPE html>
<html lang="en" style="height: 100%;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swidge</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Swidge.styles.css" asp-append-version="true" />
</head>
<body style="height: 100%; margin: 0; display: grid; grid: auto 1fr auto / 100%;">
    <header class="swidge-header">
        <a class="swidge-brand" asp-controller="Home" asp-action="Index" aria-label="Swidge inicio">
            <img src="@Url.Content("~/img/letrasSwidge.png")" alt="Swidge" />
        </a>

        <nav class="swidge-nav" aria-label="Navegación principal">
            <div class="dropdown swidge-dropdown">
                <button class="swidge-link swidge-link--primary swidge-dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Mis entradas
                </button>
                <ul class="dropdown-menu dropdown-menu-start swidge-profile-menu">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="EntradasCompradas">Mis entradas compradas</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="EntradasPublicadas">Mis entradas publicadas</a></li>
                </ul>
            </div>
            <a class="swidge-link swidge-link--secondary" asp-controller="Home" asp-action="Ayuda">Ayuda</a>
            <a class="swidge-link swidge-link--secondary" asp-controller="Home" asp-action="Landing">Sobre nosotros</a>
            <a class="swidge-link swidge-link--danger" asp-controller="Home" asp-action="PublicarEntrada">Publicar</a>
            <a class="swidge-link swidge-link--blue" asp-controller="Home" asp-action="Index">Explorar entradas</a>
        </nav>

        @if (Context.Session.GetInt32("DNI") != null)
        {
            <div class="swidge-user-wrap dropdown">
                <button class="swidge-user-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú del usuario">
                    <img src="@Url.Content("~/img/usuario.png")" alt="Usuario" />
                </button>
                <span class="swidge-username">@Context.Session.GetString("NombreUsuario")</span>
                <ul class="dropdown-menu dropdown-menu-end swidge-profile-menu">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="MiPerfil">Mi perfil</a></li>
                    <li><a class="dropdown-item" asp-controller="Session" asp-action="CerrarSesion">Cerrar sesión</a></li>
                </ul>
            </div>
        }
        else
        {
            <div class="swidge-user-wrap dropdown">
                <button class="swidge-user-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de sesión">
                    <img src="@Url.Content("~/img/usuario.png")" alt="Usuario" />
                </button>
                <ul class="dropdown-menu dropdown-menu-end swidge-profile-menu">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="IniciarSesion">Iniciar sesión</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Registrarse">Registrarse</a></li>
                </ul>
            </div>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="swidge-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="swidge-footer-logo">Swidge</h5>
                    <p>La plataforma para comprar y revender entradas de forma simple y segura.</p>
                </div>

                <div class="col-md-4 swidge-footer-links">
                    <h5>Navegación</h5>
                    <a asp-controller="Home" asp-action="Index">Explorar entradas</a>
                    <a asp-controller="Home" asp-action="PublicarEntrada">Publicar entrada</a>
                    <a asp-controller="Home" asp-action="Ayuda">Ayuda</a>
                    <a asp-controller="Home" asp-action="Landing">Sobre nosotros</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>

                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <p>@@swidgeofficial</p>
                    <p><a href="tel:+541124643329">11 2464-3329</a></p>

                    <div class="swidge-social">
                        <a href="https://www.instagram.com/swidgeofficial" target="_blank" rel="noopener" aria-label="Instagram de Swidge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                <circle cx="12" cy="12" r="4"></circle>
                                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
                            </svg>
                        </a>
                        <a href="https://www.facebook.com/swidgeofficial" target="_blank" rel="noopener" aria-label="Facebook de Swidge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                            </svg>
                        </a>
                        <a href="https://x.com/swidgeofficial" target="_blank" rel="noopener" aria-label="X de Swidge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 4l11.7 16H20L8.3 4z"></path>
                                <path d="M4.5 20l6.3-6.3M13.2 10.3L19.5 4"></path>
                            </svg>
                        </a>
                        <a href="https://www.tiktok.com/@@swidgeofficial" target="_blank" rel="noopener" aria-label="TikTok de Swidge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"></path>
                                <path d="M14 3c.4 2.6 2.1 4.2 5 4.5"></path>
                            </svg>
                        </a>
                        <a href="https://wa.me/5491124643329" target="_blank" rel="noopener" aria-label="WhatsApp de Swidge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="swidge-footer-bottom">
            &copy; 2026 - Swidge - Todos los derechos reservados
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
